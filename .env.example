# Copy to .env and fill in. Every value here is optional — with no .env at all
# Yogya runs in offline mode: rules, documents and forms all work, only the
# natural-language wording falls back to templates.

# Any LiteLLM model string. The provider is a config value, not a code change.
#   groq/llama-3.3-70b-versatile      free tier, fast, good enough
#   gemini/gemini-2.0-flash           free tier
#   ollama/llama3.2                   fully local, no key needed
#   openai/gpt-4o-mini
YOGYA_LLM_MODEL=groq/llama-3.3-70b-versatile

# Tried in order if the primary model fails (rate limit, outage).
# YOGYA_LLM_FALLBACK_MODELS=["gemini/gemini-2.0-flash"]

# Force template-only mode even when a key is present.
YOGYA_LLM_OFFLINE=false

# Human approval gates. The submission gate is ALWAYS on and this does not
# affect it — see yogya/agents/interrupts.py.
YOGYA_REQUIRE_HUMAN_APPROVAL=true

# How many times a wrongful rejection is appealed before it is escalated
# to the grievance authority.
YOGYA_MAX_APPEAL_ATTEMPTS=2

# Provider keys — set whichever matches YOGYA_LLM_MODEL.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
